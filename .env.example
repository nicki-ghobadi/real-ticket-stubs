# Server
PORT=3456

# ── AI ticket extraction (Claude vision) ───────────────────────────────
# Required for high-accuracy ticket field extraction (section, row, seat, etc.).
# Used server-side by /api/extract. Get it at
# https://console.anthropic.com/settings/keys — never expose it to the browser.
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# ── Stripe payments ───────────────────────────────────────────────────
# Payment Links (public checkout URLs — set per environment, not in source code).
# Create at https://dashboard.stripe.com/payment-links
# Turn ON "Collect customers' shipping addresses" and set after-payment redirect
# to https://YOUR-APP-URL/?checkout=success
STRIPE_PAYMENT_LINK_MAIL=https://buy.stripe.com/dRm3co4W29bl3El7uD6sw03
STRIPE_PAYMENT_LINK_FRAMED=https://buy.stripe.com/7sYdR2606drB1wd6qz6sw02

# Optional — only needed for API Checkout fallback (when a link above is unset)
# or for webhook session retrieval. Get at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Verifies Stripe webhook calls (/api/stripe/webhook). REQUIRED before you
# fulfill paid orders. Workbench → Webhooks → your destination → Signing secret.
# (or `stripe listen` for local testing). See DEPLOYMENT.md.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Security / hosting ────────────────────────────────────────────────
# Set to "production" in production (enables HSTS + sane defaults).
NODE_ENV=production
# Only needed if the frontend is on a DIFFERENT domain than this backend
# (e.g. frontend on GoHighLevel, backend on Render). Comma-separated origins
# allowed to call the API via CORS. Leave empty for same-origin/iframe embeds.
ALLOWED_ORIGINS=
# Who may embed this app in an <iframe>. For GoHighLevel, set to your GHL
# domain(s), space-separated, e.g. "https://app.yourbrand.com". Default 'self'.
FRAME_ANCESTORS='self'
# Set to "false" only if NOT behind a reverse proxy / load balancer.
# TRUST_PROXY=true

# ── Address deliverability (Google Address Validation API) ────────────
# Confirms the customer's MAILING address actually exists before you ship.
# With Stripe Payment Links the address is collected at payment, so this runs
# in the webhook (post-payment) and flags undeliverable addresses for review.
# Get a key: Google Cloud Console → enable "Address Validation API" → create an
# API key (restrict it to that API). https://developers.google.com/maps/documentation/address-validation
GOOGLE_ADDRESS_VALIDATION_API_KEY=

# Optional — alternative US-only verification
# USPS_USER_ID=

# ── Order persistence (Supabase) ──────────────────────────────────────
# Stores each paid order (one row per checkout). SERVER-ONLY: use the SERVICE
# ROLE key, never the anon/public key, and never expose it to the browser.
# Setup: create a Supabase project, then run supabase/migrations/*.sql
# in the SQL Editor (0001, 0002, 0003). Leave blank to run without a database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Confirmation emails (Resend) ──────────────────────────────────────
# Sends order confirmation to the customer after payment.
RESEND_API_KEY=
ORDER_FROM_EMAIL=orders@yourdomain.com
# Where YOU receive new-order alerts (stub PNG attached). Defaults to ORDER_FROM_EMAIL.
FULFILLMENT_EMAIL=fulfillment@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
BUSINESS_NAME=Real Ticket Stubs

# Public site URL — used to re-render print PNGs from the live preview before fulfillment emails.
# Production: https://www.realticketstubs.com
APP_BASE_URL=http://localhost:3456
